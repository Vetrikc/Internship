<configuration>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://loki:3100/loki/api/v1/push</url>
        </http>

        <format>
            <label>
                <pattern>app=${spring.application.name},level=%level</pattern>
            </label>
            <message>
                <pattern>
                    {
                    "traceId":"%X{traceId:-}",
                    "spanId":"%X{spanId:-}",
                    "message":"%msg"
                    }
                </pattern>
            </message>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="LOKI"/>
    </root>

</configuration>
